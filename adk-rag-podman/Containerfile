FROM docker.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GOOGLE_GENAI_USE_VERTEXAI=FALSE \
    CHROMA_HOST=localhost \
    CHROMA_PORT=8000

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agents/ ./agents/
COPY ingest/ ./ingest/
COPY docs/ ./docs/
COPY healthcheck.py* ./

# Run as an unprivileged user inside the container too
RUN useradd --uid 1001 --create-home appuser && chown -R appuser /app
USER 1001

EXPOSE 8080
# Production API server. For the workshop demo UI, override with:
#   adk web --host 0.0.0.0 --port 8080 /app/agents
CMD ["adk", "api_server", "--host", "0.0.0.0", "--port", "8080", "/app/agents"]
